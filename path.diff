+    resp = client.responses.create(
+        model=model,
+        input=msgs,
+        tools=tools,
+        max_output_tokens=1024,
+    )
+
+    def print_any_text(r) -> bool:
+        shown = False
+        txt = getattr(r, "output_text", None)
+        if txt:
+            console.print(Markdown(txt))
+            return True
+        try:
+            data = r.model_dump()
+        except Exception:
+            data = {}
+        outs = []
+        for item in data.get("output", []) or []:
+            if item.get("type") == "message":
+                for part in item.get("content", []) or []:
+                    if part.get("type") == "output_text" and part.get("text"):
+                        outs.append(part["text"])
+        if outs:
+            console.print(Markdown("\n\n".join(outs)))
+            shown = True
+        return shown
+
+    def iter_calls(r):
+        try:
+            data = r.model_dump()
+        except Exception:
+            data = {}
+        for it in data.get("output", []) or []:
+            t = str(it.get("type", ""))
+            if ("function_call" in t) or ("tool_call" in t):
+                yield {
+                    "id": it.get("id"),
+                    "name": it.get("name") or it.get("tool_name"),
+                    "arguments": it.get("arguments") or "{}",
+                }
+
+    while True:
+        printed = print_any_text(resp)
+        calls = list(iter_calls(resp))
+        if not calls:
+            if not printed:
+                try:
+                    console.print_json(data=resp.model_dump())
+                except Exception:
+                    console.print(repr(resp))
+            break
+        for call in calls:
+            name = call["name"]
+            args = json.loads(call["arguments"] or "{}")
+            result = call_tool(name, args)
+            resp = client.responses.create(
+                model=model,
+                previous_response_id=resp.id,
+                input=[{
+                    "role": "tool",
+                    "content": json.dumps(result, ensure_ascii=False),
+                    "tool_call_id": call["id"],
+                }],
+                max_output_tokens=1024,
+            )
