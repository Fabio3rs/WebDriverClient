@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find dependencies that consumers might need
find_dependency(CURL REQUIRED)

# Optional dependencies
if(@WEBDRIVER_USE_BOOST@)
    find_dependency(Boost COMPONENTS system thread)
endif()

if(@WEBDRIVER_USE_POCO@)
    find_dependency(Poco COMPONENTS Foundation JSON Net NetSSL Crypto)
endif()

# Include targets
include("${CMAKE_CURRENT_LIST_DIR}/WebDriverClientTargets.cmake")

# Provide imported targets
check_required_components(WebDriverClient)

# Set useful variables for consumers
set(WebDriverClient_VERSION @PROJECT_VERSION@)
set(WebDriverClient_FOUND TRUE)

# Optional feature flags for consumers
set(WebDriverClient_HAS_BOOST @WEBDRIVER_BOOST_AVAILABLE@)
set(WebDriverClient_HAS_POCO @WEBDRIVER_POCO_AVAILABLE@)
set(WebDriverClient_HAS_CONAN @WEBDRIVER_CONAN_AVAILABLE@)
