#pragma once

#include <functional>
#include <unordered_map>
#include <memory>
#include <boost/asio/strand.hpp>

namespace bidi::core {

// Forward declaration
class SubscriptionManager;

// RAII subscription handle with weak_ptr to manager for safety
class SubscriptionHandle {
public:
    SubscriptionHandle() = default;
    SubscriptionHandle(std::weak_ptr<SubscriptionManager> mgr, std::uint64_t id) noexcept
        : mgr_(std::move(mgr)), id_(id) {}
    
    SubscriptionHandle(SubscriptionHandle &&o) noexcept
        : mgr_(std::move(o.mgr_)), id_(o.id_) {
        o.id_ = 0;
    }
    
    SubscriptionHandle &operator=(SubscriptionHandle &&o) noexcept {
        if (this != &o) {
            cancel();
            mgr_ = std::move(o.mgr_);
            id_ = o.id_;
            o.id_ = 0;
        }
        return *this;
    }
    
    ~SubscriptionHandle() { cancel(); }

    void cancel();
    [[nodiscard]] bool valid() const noexcept { return id_ != 0 && !mgr_.expired(); }

private:
    std::weak_ptr<SubscriptionManager> mgr_;
    std::uint64_t id_{0};
};

// Thread-safe subscription manager using strand instead of mutex
class SubscriptionManager : public std::enable_shared_from_this<SubscriptionManager> {
public:
    using topic_t = std::string;
    using callback_t = std::function<void(std::string_view)>;

    explicit SubscriptionManager(boost::asio::strand<boost::asio::io_context::executor_type> strand)
        : strand_(std::move(strand)) {}

    // Subscribe: returns RAII handle
    template<typename CompletionToken>
    auto async_subscribe(topic_t topic, callback_t cb, CompletionToken&& token);

    // Dispatch to subscribers (strand-safe)
    template<typename CompletionToken>
    auto async_dispatch(std::string_view topic, std::string_view payload, CompletionToken&& token);

private:
    friend class SubscriptionHandle;
    void remove_subscription(std::uint64_t id);
    
    boost::asio::strand<boost::asio::io_context::executor_type> strand_;
    std::unordered_map<std::string, std::unordered_map<std::uint64_t, callback_t>> topic_callbacks_;
    std::uint64_t next_id_{1};
};

inline void SubscriptionHandle::cancel() {
    if (auto mgr = mgr_.lock(); mgr && id_ != 0) {
        mgr->remove_subscription(id_);
        id_ = 0;
    }
}

} // namespace bidi::core
```

