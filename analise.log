// Correção thread-safe para now_iso8601()
inline std::string now_iso8601() {
    using namespace std::chrono;
    auto now = system_clock::now();
    auto now_t = system_clock::to_time_t(now);
    std::ostringstream ss;
    // gmtime_r em POSIX ou gmtime_s em Windows
    struct tm tm_buf;
#ifdef _WIN32
    gmtime_s(&tm_buf, &now_t);
#else
    gmtime_r(&now_t, &tm_buf);
#endif
    ss << std::put_time(&tm_buf, "%Y-%m-%dT%H:%M:%SZ");
    return ss.str();
}

// Trace ID mais robusto
inline std::string make_trace_id() {
    auto epoch_count = std::chrono::system_clock::now().time_since_epoch().count();
    auto thread_id = std::hash<std::thread::id>{}(std::this_thread::get_id());
    std::ostringstream ss;
    ss << std::hex << epoch_count << "_" << thread_id;
    return ss.str();
}

// Função base para eliminar duplicação
inline void emit_log(const std::string& level,
                    const std::string& msg,
                    const std::error_code& err_code = {},
                    const std::exception_ptr& ex_ptr = nullptr,
                    const std::string& trace_id = {}) {
    auto payload = build_log(level, msg, err_code, ex_ptr, trace_id);
    auto& sink = get_default_sink_ref();
    if (sink) {
        sink(payload);
    } else {
        // Usar sempre o mesmo fallback
        std::cout << payload << '\n';
    }
}

// Simplificar funções de log
inline void log_error(const std::string& msg,
                     const std::error_code& err_code = {},
                     const std::exception_ptr& ex_ptr = nullptr,
                     const std::string& trace_id = {}) {
    emit_log("error", msg, err_code, ex_ptr, trace_id);
}
```

