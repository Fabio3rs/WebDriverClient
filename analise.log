```cpp
// tests/id_serialization_test.cpp
#include "bidi/core.hpp"
#include <gtest/gtest.h>

using namespace bidi::core;

TEST(IdSafety, MaxSafeId) {
    constexpr auto max = MAX_SAFE_ID;
    EXPECT_TRUE(is_id_safe(max));
    EXPECT_FALSE(is_id_safe(max + 1ULL));
}

TEST(ParseResponse, SafeIdSerialization) {
    const auto id = MAX_SAFE_ID;
    // Use valid params object instead of empty
    boost::json::object params;
    params["context"] = "test-context";
    const auto payload = build_command(id, "dummy.method", params);

    auto parsed_val = boost::json::parse(payload);
    ASSERT_TRUE(parsed_val.is_object());
    auto &obj = parsed_val.as_object();
    // id should be int64_t when safe (more specific)
    ASSERT_TRUE(obj["id"].is_int64());
    EXPECT_EQ(obj["id"].as_int64(), static_cast<std::int64_t>(id));

    // Use consistent approach for response construction
    const auto resp_payload = build_success_response(id, boost::json::object{});
    auto parsed = parse_response(resp_payload);
    ASSERT_TRUE(parsed.has_value());
    EXPECT_EQ(parsed->id, id);
    EXPECT_TRUE(is_id_safe(parsed->id));
}

TEST(ParseResponse, UnsafeIdSerialization) {
    const auto id = MAX_SAFE_ID + 1ULL;
    boost::json::object params;
    params["context"] = "test-context";
    const auto payload = build_command(id, "dummy.method", params);

    auto parsed_val = boost::json::parse(payload);
    ASSERT_TRUE(parsed_val.is_object());
    auto &obj = parsed_val.as_object();
    // id should be string when unsafe
    ASSERT_TRUE(obj["id"].is_string());
    EXPECT_EQ(std::stoull(obj["id"].as_string().c_str()), id);

    // Test that parse_response handles string-encoded IDs correctly
    const auto resp_payload = build_success_response_with_string_id(
        std::to_string(id), boost::json::object{});
    auto parsed = parse_response(resp_payload);
    
    // Add explicit verification that string parsing worked
    ASSERT_TRUE(parsed.has_value()) << "parse_response should handle string IDs";
    EXPECT_EQ(parsed->id, id);
    EXPECT_FALSE(is_id_safe(parsed->id));
}

// Helper test to verify round-trip consistency
TEST(IdSafety, RoundTripConsistency) {
    const std::vector<id_type> test_ids = {
        1ULL, 42ULL, MAX_SAFE_ID - 1ULL, MAX_SAFE_ID, MAX_SAFE_ID + 1ULL
    };
    
    for (const auto& original_id : test_ids) {
        boost::json::object params;
        params["test"] = "round-trip";
        
        const auto command_payload = build_command(original_id, "test.method", params);
        auto parsed_command = boost::json::parse(command_payload);
        
        // Extract id from serialized command and verify it can round-trip
        auto &cmd_obj = parsed_command.as_object();
        id_type extracted_id;
        
        if (cmd_obj["id"].is_int64()) {
            extracted_id = static_cast<id_type>(cmd_obj["id"].as_int64());
        } else if (cmd_obj["id"].is_string()) {
            extracted_id = std::stoull(cmd_obj["id"].as_string().c_str());
        } else {
            FAIL() << "ID serialized in unexpected format";
        }
        
        EXPECT_EQ(extracted_id, original_id) << "Round-trip failed for ID: " << original_id;
    }
}
```

