// 1. Substituir promise por completion handler mais adequado
struct PendingEntryVec {
    id_type id{0};
    std::string method;
    boost::json::object params;
    std::chrono::steady_clock::time_point created;
    // Use completion token pattern mais alinhado com Asio
    std::function<void(boost::system::error_code, boost::json::object)> completion_handler;

    void reset() noexcept {
        id = 0;
        method.clear();
        params.clear();
        created = std::chrono::steady_clock::time_point{};
        completion_handler = nullptr;
    }
};

// 2. Operadores mais seguros com verificação
[[nodiscard]] PendingEntryVec *operator->() noexcept {
    if (pool_handle_) {
        return pool_handle_.operator->();
    }
    if (fallback_) {
        return fallback_.get();
    }
    // Log error ou assert em debug mode
    return nullptr;
}

[[nodiscard]] PendingEntryVec &operator*() noexcept {
    auto* ptr = operator->();
    // Assert em debug, comportamento definido em release
    return *ptr;
}

// 3. operator bool mais simples
explicit operator bool() const noexcept { 
    return pool_handle_ || fallback_; 
}

// 4. Timeout como constante
static constexpr std::chrono::milliseconds kNoWaitTimeout{0};

// 5. Pool policy configurável
explicit PendingEntryPoolVec(
    std::size_t initial_size = kDefaultPendingPool,
    utils::PoolVec<PendingEntryVec>::Policy policy = utils::PoolVec<PendingEntryVec>::Policy::Recreate)
    : pool_(initial_size, policy) {}
