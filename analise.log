#include "WebDriverClient.hpp"
#include "asyncx.hpp"
#include "bidi/core.hpp"
#include "bidi/ids.hpp"
#include <iostream>
#include <boost/asio.hpp>

// Demo seguindo arquitetura bidi-x
int main() {
    try {
        // Usar io_context único conforme arquitetura
        boost::asio::io_context io_ctx;
        auto work_guard = boost::asio::make_work_guard(io_ctx);
        
        WebDriverClient client{io_ctx};
        
        // Operação lazy - só executa com terminal
        auto lazy_operation = client.create_browsing_context()
            .and_then([&](const std::string& ctx_id) {
                return client.navigate(ctx_id, "https://example.com");
            })
            .timeout(std::chrono::seconds{10})
            .on_error([](std::error_code ec) {
                std::cerr << "Error: " << ec.message() << std::endl;
                return std::string{};
            });
        
        // Terminal materializa a operação
        lazy_operation.finally([&](auto result, auto error, auto) {
            if (result) {
                std::cout << "Navigation completed successfully" << std::endl;
            }
            work_guard.reset();
        });
        
        // Event loop único
        io_ctx.run();
        
    } catch (const std::exception& e) {
        std::cerr << "Demo failed: " << e.what() << std::endl;
        return 1;
    }
    
    return 0;
}
```

