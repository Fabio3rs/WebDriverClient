```cpp
namespace {

// Helper especializado para testes - usa serialize direto por simplicidade
// Em produção, usar boost::json::serializer conforme arquitetura
[[nodiscard]] static auto make_success_response(
    id_type id, 
    const boost::json::object& result = {}) -> std::string {
    
    boost::json::object o;
    o["id"] = static_cast<std::int64_t>(id);
    o["type"] = "success";
    o["result"] = result;
    return boost::json::serialize(o);
}

[[nodiscard]] static auto make_error_response(
    id_type id,
    const std::string& code = "invalid argument",
    const std::string& msg = "bad") -> std::string {
    
    boost::json::object o;
    o["id"] = static_cast<std::int64_t>(id);
    o["type"] = "error";
    o["error"] = code;
    o["message"] = msg;
    return boost::json::serialize(o);
}

[[nodiscard]] static auto make_event(
    const std::string& method,
    const boost::json::object& params = {}) -> std::string {
    
    boost::json::object o;
    o["type"] = "event";
    o["method"] = method;
    o["params"] = params;
    return boost::json::serialize(o);
}

} // namespace
```

