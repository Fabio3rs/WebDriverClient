```cpp
// Substituir todo o teste EventDispatchAndUnsubscribe por:
TEST(BidiSessionRouting, EventDispatchAndUnsubscribe) {
    boost::asio::io_context ioc;
    auto ws = std::make_shared<WebSocketClient>(ioc);
    auto session = std::make_shared<BiDiSession>(ws);
    
    // Usar executor diretamente sem thread separada
    std::promise<void> test_done;
    auto future = test_done.get_future();
    
    boost::asio::co_spawn(
        ioc.get_executor(),
        [session, &test_done]() -> boost::asio::awaitable<void> {
            std::atomic<int> event_calls{0};
            
            {
                auto sub = session->subscribe_event_scoped(
                    std::string(bidi::ids::events::log_entryAdded), {},
                    [&event_calls](const ParsedEvent &event) {
                        EXPECT_EQ(event.method, bidi::ids::events::log_entryAdded);
                        event_calls.fetch_add(1);
                    });

                // Usar timer determinístico baseado em completion
                auto subscription_ready = co_await session->wait_for_subscription_ready();
                
                // Usar builder ao invés de JSON hardcoded
                auto event_json = bidi::core::build_event(
                    bidi::ids::events::log_entryAdded, {});
                session->test_inject_message(event_json);
                
                EXPECT_EQ(event_calls.load(), 1);
                
                co_await sub.async_cancel();
                
                // Verificar que evento não é mais processado
                session->test_inject_message(event_json);
                EXPECT_EQ(event_calls.load(), 1);
            }
            
            test_done.set_value();
            co_return;
        },
        boost::asio::detached);
    
    // Run apenas até completion
    ioc.run_until(future.wait_for(std::chrono::seconds(5)) == std::future_status::ready);
}

// Para o primeiro teste, usar nomes canônicos:
TEST(BidiSessionRouting, PendingResponsesReordered) {
    boost::asio::io_context ioc;
    auto ws = std::make_shared<WebSocketClient>(ioc);
    auto session = std::make_shared<BiDiSession>(ws);

    std::atomic<int> called1{0}, called2{0};
    
    session->send_command(bidi::ids::methods::bc_create, {}, 
        [&called1](const ParsedResponse &r) {
            EXPECT_TRUE(r.is_success);
            called1.fetch_add(1);
        });
    
    session->send_command(bidi::ids::methods::script_evaluate, {}, 
        [&called2](const ParsedResponse &r) {
            EXPECT_TRUE(r.is_success);
            called2.fetch_add(1);
        });

    // Usar builders para responses
    auto response1 = bidi::core::build_success_response(1, {});
    auto response2 = bidi::core::build_success_response(2, {});
    
    session->test_inject_message(response2);
    session->test_inject_message(response1);
    
    EXPECT_EQ(called1.load(), 1);
    EXPECT_EQ(called2.load(), 1);
}
```

