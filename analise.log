```cpp
// Correção 1: Usar strand em lugar de mutex
struct State {
    explicit State(boost::asio::any_io_executor ex_) 
        : ex(std::move(ex_)), strand(boost::asio::make_strand(ex)) {}
    boost::asio::any_io_executor ex;
    boost::asio::strand<boost::asio::any_io_executor> strand;
    std::vector<std::pair<std::uint64_t, Handler>> subs; // sem mutex
    std::vector<Subscription> holds;
    std::atomic<std::uint64_t> next_id{1};
};

// Correção 2: Push thread-safe com strand
void push(const E &e) const {
    boost::asio::dispatch(st_->strand, [st = st_, e]() {
        for (auto &p : st->subs) {
            boost::asio::post(st->ex, [handler = p.second, e]() { 
                handler(e); 
            });
        }
    });
}

// Correção 3: Subscribe com strand
Subscription subscribe(Handler h) const {
    const auto id = st_->next_id.fetch_add(1, std::memory_order_relaxed);
    boost::asio::post(st_->strand, [st = st_, id, h = std::move(h)]() mutable {
        st->subs.emplace_back(id, std::move(h));
    });
    // ... resto igual
}

// Correção 4: Adicionar [[nodiscard]]
[[nodiscard]] bool valid() const { return (bool)st_; }
```

