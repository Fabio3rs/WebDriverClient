constexpr int DEFAULT_MAX_TRIES = 3;
constexpr std::chrono::milliseconds DEFAULT_FIRST_DELAY{200};
constexpr std::chrono::milliseconds MIN_RETRY_DELAY{1};  // Nova constante
constexpr double DEFAULT_MULTIPLIER = 2.0;
constexpr std::chrono::milliseconds DEFAULT_MAX_DELAY{3000};
constexpr double DEFAULT_JITTER = 0.2;

// ... manter structs RetryPolicy e RetryState ...

// Helper para conversões seguras
static auto safe_duration_cast(double value) -> std::chrono::milliseconds {
    auto casted = static_cast<long long>(std::max(value, 1.0));
    return std::chrono::milliseconds{
        std::min(casted, std::numeric_limits<long long>::max())
    };
}

// Função movida para fora do namespace anônimo
static auto calculate_next_delay_with_jitter(
    const RetryPolicy &policy, 
    const std::shared_ptr<RetryState> &retry_state) -> std::chrono::milliseconds {
    
    const auto base_ms = static_cast<double>(retry_state->delay.count());
    std::uniform_real_distribution<double> dist{-policy.jitter, +policy.jitter};
    double jitter_factor = std::max(1.0 + dist(retry_state->rng), 0.0);

    auto next_ms = safe_duration_cast(base_ms * jitter_factor);
    if (policy.max_delay.count() > 0) {
        next_ms = std::min(next_ms, policy.max_delay);
    }

    // Atualiza delay para próxima tentativa
    retry_state->delay = safe_duration_cast(base_ms * policy.multiplier);
    if (policy.max_delay.count() > 0) {
        retry_state->delay = std::min(retry_state->delay, policy.max_delay);
    }

    return next_ms;
}

// Substituir std::cerr por logging padronizado:
// std::cerr << "Exception..." → bidi::log_error("Exception...");

// Cancelamento strand-safe:
if (retry_state->current) {
    // Use padrão strand + timer cancel em vez de request_stop()
    retry_state->current->cancel(); // ou método equivalente strand-safe
}

// Remove definição duplicada de schedule_retry no final do arquivo

} // namespace bidi
