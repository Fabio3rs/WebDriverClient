    schedule_timeout(std::chrono::milliseconds duration, StrandTimeoutHandler handler);
    
    [[nodiscard]] std::expected<void, error_code> cancel_timeout(id_type id);
    
    void start();  // Terminal obrigatório
    void stop();

private:
