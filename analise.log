// test_new_bidi.cpp — Test program for new BiDi Core architecture
#include "bidi/client.hpp"
#include "bidi/logging.hpp"
#include <boost/asio.hpp>

int main() {
    try {
        boost::asio::io_context ioc;
        
        // Add work guard to prevent premature termination
        auto work_guard = boost::asio::make_work_guard(ioc);

        bidi::logging::log_info("Testing new BiDi Core architecture...");

        // Test with timeout and error handling
        auto client_task = bidi::Client::connect(ioc, "ws://localhost:9222/devtools/browser")
            .timeout(std::chrono::seconds{10});

        // Use and_then for cleaner chaining instead of nested callbacks
        auto test_flow = client_task
            .and_then([](auto client) {
                bidi::logging::log_info("Client connected successfully");
                return client->create_context(bidi::commands::browsing_context::CreateType::tab);
            })
            .and_then([](auto context_id) {
                bidi::logging::log_info("Created context: " + context_id);
                // Avoid string concatenation, use structured logging
                return std::make_pair(context_id, context_id);
            })
            .and_then([](auto ctx_pair) {
                auto [client, context_id] = ctx_pair;
                return client->navigate(context_id, "https://example.com");
            })
            .on_error([](std::error_code ec) {
                bidi::logging::log_error("Test flow failed", ec);
                return std::string{}; // Return empty for error case
            });

        test_flow.finally([&work_guard](auto result_opt, auto ec_opt, auto ep) {
            if (result_opt && !result_opt->empty()) {
                bidi::logging::log_info("Navigated to: " + *result_opt);
            }
            work_guard.reset(); // Allow io_context to stop
        });

        // Run event loop
        ioc.run();
        bidi::logging::log_info("Test completed");

    } catch (const bidi::BiDiException& e) {
        bidi::logging::log_error("BiDi Exception", e.error_code());
        return 1;
    } catch (const std::exception& e) {
        bidi::logging::log_error("Standard Exception: " + std::string{e.what()});
        return 1;
    }

    return 0;
}
```

