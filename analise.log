```cpp
#pragma once

#include <string>

namespace bidi::helpers::wait {

/**
 * JavaScript helper para aguardar elementos DOM sem polling.
 * Uso: via script.evaluate com awaitPromise=true, resultOwnership="root"
 * 
 * Parâmetros:
 * - selector: string CSS ou XPath
 * - selectorType: "css"|"css selector"|"xpath"  
 * - timeout: tempo limite em ms (padrão 5000)
 * 
 * Retorna: Promise<Element> que resolve quando encontra ou rejeita no timeout
 */
constexpr const char* wait_for_element_script = R"js(
(function waitForElement(selector, selectorType, timeout = 5000) {
    return new Promise((resolve, reject) => {
        // Validação de entrada
        if (!selector || typeof selector !== 'string' || selector.trim() === '') {
            reject(new Error('Invalid selector: must be non-empty string'));
            return;
        }
        
        const validTypes = ['css', 'css selector', 'xpath'];
        if (!validTypes.includes(selectorType)) {
            reject(new Error(`Invalid selectorType: must be one of ${validTypes.join(', ')}`));
            return;
        }
        
        if (typeof timeout !== 'number' || timeout <= 0) {
            reject(new Error('Invalid timeout: must be positive number'));
            return;
        }

        function getElement(selector, type) {
            try {
                if (type === "css" || type === "css selector") {
                    return document.querySelector(selector);
                } else if (type === "xpath") {
                    return document.evaluate(
                        selector,
                        document,
                        null,
                        XPathResult.FIRST_ORDERED_NODE_TYPE,
                        null
                    ).singleNodeValue;
                }
            } catch (e) {
                throw new Error(`Error evaluating selector "${selector}": ${e.message}`);
            }
            return null;
        }

        // Verificação imediata
        try {
            const existingElement = getElement(selector, selectorType);
            if (existingElement) { 
                resolve(existingElement); 
                return; 
            }
        } catch (e) {
            reject(e);
            return;
        }

        let timeoutId;
        const observer = new MutationObserver(() => {
            try {
                const element = getElement(selector, selectorType);
                if (element) {
                    if (timeoutId) { clearTimeout(timeoutId); }
                    observer.disconnect();
                    resolve(element);
                }
            } catch (e) {
                if (timeoutId) { clearTimeout(timeoutId); }
                observer.disconnect();
                reject(e);
            }
        });

        // Monitor documentElement ao invés de só body
        const target = document.documentElement || document.body;
        observer.observe(target, { childList: true, subtree: true, attributes: true });

        timeoutId = setTimeout(() => {
            observer.disconnect();
            // Última tentativa antes de falhar
            try {
                const element = getElement(selector, selectorType);
                if (element) { 
                    resolve(element); 
                    return; 
                }
            } catch (e) {
                reject(new Error(`Timeout reached after ${timeout}ms: ${e.message}`));
                return;
            }
            reject(new Error(`Timeout reached after ${timeout}ms: Element "${selector}" (${selectorType}) not found.`));
        }, timeout);
    });
})(arguments[0], arguments[1], arguments[2]);
)js";

/**
 * Helper para aguardar elemento visível (além de presente no DOM)
 */
constexpr const char* wait_for_visible_element_script = R"js(
// Implementação similar mas verifica visibility
)js";

} // namespace bidi::helpers::wait
```

