TEST_F(PendingEntryTest, TimeoutRace) {
    bool timeout_fired = false;
    bool response_received = false;
    
    // Simular pending entry com timer
    auto entry = pool_->acquire();
    entry->id = 1;
    entry->timer = std::make_shared<boost::asio::steady_timer>(*strand_);
    entry->timer->expires_after(100ms);
    
    // Timer callback
    entry->timer->async_wait([&](boost::system::error_code ec) {
        if (!ec) {
            timeout_fired = true;
        }
    });
    
    // Simular resposta tardia (após 200ms)
    boost::asio::steady_timer late_response(*strand_);
    late_response.expires_after(200ms);
    late_response.async_wait([&](boost::system::error_code ec) {
        if (!ec && pool_->find_by_id(1) == nullptr) {
            response_received = true; // Deveria ser ignorada
        }
    });
    
    ioc_->run_for(300ms);
    
    EXPECT_TRUE(timeout_fired);
    EXPECT_TRUE(response_received); // Confirma que response foi recebida mas ignorada
}

