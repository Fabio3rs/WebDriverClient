```cpp
// ThreadPool.hpp — small RAII accessor for a global thread_pool used for
// blocking work that needs to post back to the main executor
#pragma once

#include <algorithm>
#include <boost/asio/thread_pool.hpp>
#include <thread>

namespace webdriver {

// Returns a global thread pool for blocking operations that cannot run on the strand
// Size defaults to hardware_concurrency but can be overridden via environment
inline boost::asio::thread_pool &global_thread_pool() {
    // Thread-safe static initialization (C++11+)
    static std::size_t n = []() -> std::size_t {
        // Allow override via environment variable for testing/tuning
        if (const char* env = std::getenv("WEBDRIVER_THREAD_POOL_SIZE")) {
            try {
                auto size = std::stoul(env);
                return std::max<std::size_t>(1, size);
            } catch (...) {
                // Fall through to default
            }
        }
        return std::max<std::size_t>(1, std::thread::hardware_concurrency());
    }();
    
    static boost::asio::thread_pool pool(n);
    return pool;
}

// For testing: allow graceful shutdown
inline void shutdown_global_thread_pool() {
    global_thread_pool().stop();
    global_thread_pool().join();
}

} // namespace webdriver
```

