TEST_F(SubscriptionManagerTest, MultipleSubscriptionsRefcount) {
    int callback_count = 0;
    
    auto handle1 = manager.subscribe("log.entryAdded", 
        [&](std::string_view) noexcept { ++callback_count; });
    auto handle2 = manager.subscribe("log.entryAdded", 
        [&](std::string_view) noexcept { ++callback_count; });
    
    manager.dispatch("log.entryAdded", R"({"level":"error"})");
    EXPECT_EQ(callback_count, 2);
    
    // Testa refcount - primeira destruição não deve unsubscribe
    handle1.reset();
    callback_count = 0;
    manager.dispatch("log.entryAdded", R"({"level":"warn"})");
    EXPECT_EQ(callback_count, 1);
}

TEST_F(SubscriptionManagerTest, ErrorHandling) {
    // Testa callback que pode falhar sem quebrar o sistema
    auto handle = manager.subscribe("test.topic", 
        [](std::string_view payload) noexcept {
            // Simula processamento que pode falhar
            if (payload == "invalid") {
                // Log erro, mas não lança exceção
                return;
            }
        });
    
    // Não deve crashar
    EXPECT_NO_THROW(manager.dispatch("test.topic", "invalid"));
    EXPECT_NO_THROW(manager.dispatch("test.topic", "valid"));
}
