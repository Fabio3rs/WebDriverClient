            auto timer = std::make_shared<boost::asio::steady_timer>(session_->get_strand());
            timer->expires_after(session_->default_timeout());
            
            auto params = commands::browsing_context::create(type);
            session_->register_pending(id, std::move(resolver), timer);
            session_->send_command_impl(id, bidi::ids::methods::bc_create, params);
        });
    });
}
