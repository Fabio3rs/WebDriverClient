```cpp
auto setup_watchdog(int seconds) -> void {
    watchdog_timer_ = std::make_shared<boost::asio::steady_timer>(
        io_context_.get_executor());
    watchdog_timer_->expires_after(std::chrono::seconds(seconds));
    watchdog_timer_->async_wait([this](const auto& ec) {
        handle_watchdog_timeout(ec);
    });
}

auto handle_watchdog_timeout(const boost::system::error_code& ec) -> void {
    if (ec == boost::asio::error::operation_aborted) {
        return;
    }
    if (!finished.load(std::memory_order_acquire)) {
        logging::log_error("Watchdog timeout reached, stopping io_context");
        boost::asio::post(io_context_.get_executor(), [this]() {
            io_context_.stop();
        });
    }
}
```

