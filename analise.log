#pragma once
#ifndef STRUTILS_HPP
#define STRUTILS_HPP

#include <algorithm>
#include <array>
#include <optional>
#include <regex>
#include <span>
#include <string>
#include <string_view>
#include <tuple>
#include <vector>

namespace strutils {

    inline void to_upper(std::string &str) {
        std::transform(str.begin(), str.end(), str.begin(),
                       [](unsigned char c) -> unsigned char {
                           return static_cast<unsigned char>(std::toupper(c));
                       });
    }

    // Corrigir constexpr_strncpy com bounds checking
    inline constexpr auto safe_strncpy(char *dest, const char *src,
                                       const size_t dest_size, const size_t n) -> char * {
        const size_t copy_size = std::min(n, dest_size - 1);
        for (size_t i = 0; i < copy_size && src[i] != '\0'; i++) {
            dest[i] = src[i];
        }
        dest[copy_size] = '\0';
        return dest;
    }

    // Corrigir url_decode sem unordered_map
    auto url_decode(const std::string &str) -> std::string {
        std::string result;
        result.reserve(str.size());

        constexpr auto hex_to_int = [](char c) -> int {
            if (c >= '0' && c <= '9') return c - '0';
            if (c >= 'A' && c <= 'F') return c - 'A' + 10;
            if (c >= 'a' && c <= 'f') return c - 'a' + 10;
            return -1;
        };

        for (size_t i = 0; i < str.size(); ++i) {
            if (str[i] == '%' && i + 2 < str.size()) {
                int high = hex_to_int(str[i + 1]);
                int low = hex_to_int(str[i + 2]);
                if (high >= 0 && low >= 0) {
                    result.push_back(static_cast<char>((high << 4) | low));
                    i += 2;
                    continue;
                }
            }
            result.push_back(str[i]);
        }
        return result;
    }

    // Remover duplicação - manter apenas split como nome mais comum
    template <class StrType = std::string>
    auto split(std::string_view strview, std::string_view delimiter) -> std::vector<StrType> {
        std::vector<StrType> result;
        
        if (strview.empty()) {
            return result;
        }
        
        if (delimiter.empty()) {
            result.emplace_back(strview);
            return result;
        }

        size_t start = 0;
        size_t end = 0;
        
        while ((end = strview.find(delimiter, start)) != std::string_view::npos) {
            result.emplace_back(strview.substr(start, end - start));
            start = end + delimiter.size();
        }
        
        result.emplace_back(strview.substr(start));
        return result;
    }

} // namespace strutils

#endif
```

