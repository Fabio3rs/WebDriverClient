asyncx::Async<boost::json::value> wait_for_element(
    const std::string& context,
    const std::string& selector,
    std::chrono::milliseconds timeout = std::chrono::seconds(5)
) {
    std::string script = R"js(
        return new Promise((resolve, reject) => {
            const existing = document.querySelector(arguments[0]);
            if (existing) return resolve(existing);
            
            const observer = new MutationObserver(() => {
                const el = document.querySelector(arguments[0]);
                if (el) {
                    observer.disconnect();
                    resolve(el);
                }
            });
            
            observer.observe(document.body, {childList: true, subtree: true});
            
            setTimeout(() => {
                observer.disconnect();
                reject(new Error(`Timeout: Element "${arguments[0]}" not found`));
            }, arguments[1]);
        });
    )js";
    
    return client_->script_evaluate(context, script, selector, timeout.count())
           .timeout(timeout + std::chrono::seconds(1));
}
```

