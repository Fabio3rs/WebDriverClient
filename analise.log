#pragma once

#include "bidi/core.hpp"
#include <boost/json.hpp>
#include <boost/json/monotonic_resource.hpp>
#include <cstdint>
#include <expected>
#include <limits>
#include <string>
#include <string_view>

namespace bidi::message {

using id_type = bidi::core::id_type;

[[nodiscard]] inline bool is_id_safe(std::uint64_t id) noexcept {
    return bidi::core::is_id_safe(id);
}

[[nodiscard]] inline std::string build_command(id_type id, std::string_view method,
                                               const boost::json::object &params = {}) noexcept {
    return bidi::core::build_command(id, method, params);
}

enum class MessageKind { Response, Event, Unknown };

// Fast-path: scan only for "type":"event" or "id": without full DOM
[[nodiscard]] inline MessageKind detect_message_kind(std::string_view payload) noexcept {
    // Lightweight scan for key indicators
    if (payload.find(R"("type":"event")") != std::string_view::npos) {
        return MessageKind::Event;
    }
    if (payload.find(R"("id":)") != std::string_view::npos) {
        return MessageKind::Response;
    }
    return MessageKind::Unknown;
}

// Full parse version using arena when DOM is needed
[[nodiscard]] inline std::expected<MessageKind, std::error_code> 
parse_message_kind_with_arena(std::string_view payload, 
                              boost::json::monotonic_resource& arena) noexcept {
    try {
        boost::json::stream_parser p{boost::json::storage_ptr{&arena}};
        p.write(payload.data(), payload.size());
        p.finish();
        boost::json::value v = p.release();
        
        if (!v.is_object()) {
            return std::unexpected{bidi::errc::decode_error};
        }
        
        const auto &obj = v.as_object();
        if (auto it_type = obj.find("type"); 
            it_type != obj.end() && it_type->value().is_string() && 
            it_type->value().as_string() == "event") {
            return MessageKind::Event;
        }
        
        if (obj.if_contains("id")) {
            return MessageKind::Response;
        }
        
        return MessageKind::Unknown;
    } catch (...) {
        return std::unexpected{bidi::errc::decode_error};
    }
}

} // namespace bidi::message
```

## PONTOS POSITIVOS

1. **Boa separação de responsabilidades**: Header focado em detecção de mensagens
2. **Uso correto de core utilities**: Reutiliza `bidi::core::is_id_safe` e `build_command`
3. **Namespace apropriado**: Organização clara dos utilitários de mensagem
4. **Include guards apropriados**: Uso de `#pragma once`
5. **Tipos corretos**: Uso de `id_type` e `std::string_view` para eficiência

