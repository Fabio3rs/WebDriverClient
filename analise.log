```cpp
#pragma once
#include <stdexcept>
#include <string>
#include <system_error>
#include <chrono>

namespace bidi {
    // Forward declaration for ErrorDetail integration
    struct ErrorDetail;
    
    enum class errc {
        timeout = 1,
        transport,
        server_error,
        decode_error,
        cancelled,
        unsupported
    };
}

namespace webdriver {
    
    /// Base exception for WebDriver operations - use only in sync facades
    class WebDriverException : public std::runtime_error {
    public:
        explicit WebDriverException(const std::string& msg) noexcept
            : std::runtime_error(msg) {}
        
        explicit WebDriverException(const char* msg) noexcept
            : std::runtime_error(msg) {}
        
        ~WebDriverException() noexcept override = default;
    };
    
    /// Connection-related errors (maps to errc::transport)
    class [[nodiscard]] WebDriverConnectionException : public WebDriverException {
    public:
        explicit WebDriverConnectionException(const std::string& msg) noexcept
            : WebDriverException(msg) {}
    };
    
    /// Session management errors  
    class [[nodiscard]] WebDriverSessionException : public WebDriverException {
    public:
        explicit WebDriverSessionException(const std::string& msg) noexcept
            : WebDriverException(msg) {}
    };
    
    /// Timeout errors (maps to errc::timeout)
    class [[nodiscard]] WebDriverTimeoutException : public WebDriverException {
    public:
        explicit WebDriverTimeoutException(const std::string& msg) noexcept
            : WebDriverException(msg) {}
        
        explicit WebDriverTimeoutException(const std::string& msg, 
                                         std::chrono::milliseconds duration) noexcept
            : WebDriverException(msg + " (duration: " + std::to_string(duration.count()) + "ms)")
            , duration_{duration} {}
        
        [[nodiscard]] std::chrono::milliseconds duration() const noexcept { 
            return duration_; 
        }
        
    private:
        std::chrono::milliseconds duration_{};
    };
    
    /// Element not found errors
    class [[nodiscard]] WebDriverNoSuchElementException : public WebDriverException {
    public:
        explicit WebDriverNoSuchElementException(const std::string& msg) noexcept
            : WebDriverException(msg) {}
    };
    
    /// Invalid argument errors (maps to errc::server_error)
    class [[nodiscard]] WebDriverInvalidArgumentException : public WebDriverException {
    public:
        explicit WebDriverInvalidArgumentException(const std::string& msg) noexcept
            : WebDriverException(msg) {}
    };
    
    /// Unknown/generic errors
    class [[nodiscard]] WebDriverUnknownErrorException : public WebDriverException {
    public:
        explicit WebDriverUnknownErrorException(const std::string& msg) noexcept
            : WebDriverException(msg) {}
    };
    
    /// Helper to convert error_code + ErrorDetail to exception (for sync facades only)
    [[nodiscard]] WebDriverException make_exception_from_error_code(std::error_code ec, 
                                                                   const std::string& detail = "");
    
} // namespace webdriver
```

