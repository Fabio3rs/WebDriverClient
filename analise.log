void handleClientAsync(int client_fd) {
    auto timer = std::make_shared<boost::asio::steady_timer>(strand_);
    timer->expires_after(std::chrono::seconds(30));
    
    // Setup corrida read vs timeout
    timer->async_wait([client_fd](auto ec) {
        if (!ec) {
            close(client_fd);  // timeout
        }
    });
}
