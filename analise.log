#pragma once

#include "bidi/logging.hpp" // Para logging canônico
#include <expected>
#include <Poco/Dynamic/Var.h>
#include <Poco/JSON/Array.h>
#include <Poco/JSON/Object.h>
#include <Poco/JSON/Parser.h>

namespace PocoJsonWrapperIt {

template <class T> 
struct iterator {
    using iterator_category = std::forward_iterator_tag;
    using value_type = T;
    using difference_type = std::ptrdiff_t;
    using pointer = value_type*;
    using reference = value_type&;

    value_type storage_;
    std::variant<size_t, Poco::JSON::Object::ConstIterator> state_;

    iterator() = default;

    iterator(Poco::JSON::Array::Ptr arr, size_t index) noexcept
        : storage_(Poco::Dynamic::Var(arr)), state_(index) {}

    iterator(Poco::JSON::Object::Ptr obj, Poco::JSON::Object::ConstIterator it) noexcept
        : storage_(Poco::Dynamic::Var(obj)), state_(it) {}

    iterator& operator++() noexcept {
        std::visit([](auto& s) { ++s; }, state_);
        return *this;
    }

    [[nodiscard]] bool operator!=(const iterator& other) const noexcept {
        return state_ != other.state_;
    }

    [[nodiscard]] value_type operator*() const {
        return std::visit([this](const auto& s) -> value_type {
            if constexpr (std::is_same_v<std::decay_t<decltype(s)>, size_t>) {
                return storage_.value.template extract<Poco::JSON::Array::Ptr>()->get(s);
            } else {
                return s->second;
            }
        }, state_);
    }
};

} // namespace PocoJsonWrapperIt

struct PocoJsonWrapper {
    using iterator = PocoJsonWrapperIt::iterator<PocoJsonWrapper>;

    PocoJsonWrapper() = default;
    
    template<typename T>
    requires (!std::same_as<std::decay_t<T>, PocoJsonWrapper>)
    explicit PocoJsonWrapper(T&& val) : value_(std::forward<T>(val)) {}

    // Parse with error handling
    [[nodiscard]] static std::expected<PocoJsonWrapper, std::string> 
    parse(const std::string& json_str) noexcept {
        try {
            Poco::JSON::Parser parser;
            auto result = parser.parse(json_str);
            return PocoJsonWrapper{result};
        } catch (const std::exception& e) {
            bidi::log_error("JSON parse failed: {}", e.what());
            return std::unexpected{e.what()};
        }
    }

    [[nodiscard]] bool is_object() const noexcept {
        return !value_.isEmpty() && 
               value_.type() == typeid(Poco::JSON::Object::Ptr);
    }

    [[nodiscard]] std::expected<std::string, std::string> 
    dump() const noexcept {
        try {
            std::ostringstream oss;
            if (is_object()) {
                value_.extract<Poco::JSON::Object::Ptr>()->stringify(oss);
            } else if (is_array()) {
                value_.extract<Poco::JSON::Array::Ptr>()->stringify(oss);
            } else {
                return std::unexpected{"Not a JSON object or array"};
            }
            return oss.str();
        } catch (const std::exception& e) {
            bidi::log_error("JSON dump failed: {}", e.what());
            return std::unexpected{e.what()};
        }
    }

private:
    Poco::Dynamic::Var value_;
};
```

