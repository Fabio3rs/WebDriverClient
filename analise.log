template<typename CompletionToken>
auto send_command_async(const std::string& method, 
                       const boost::json::object& params,
                       std::chrono::milliseconds timeout,
                       CompletionToken&& token) {
    return boost::asio::async_initiate<CompletionToken, 
        void(boost::system::error_code, boost::json::object)>(
        [this, self = shared_from_this(), method, params, timeout]
        (auto&& handler) mutable {
            auto id = next_id_.fetch_add(1);
            auto entry = acquire_pending_entry();
            entry->method = method;
            entry->params = params;
            
            threading_->post_ws([this, self, id, entry, timeout, 
                               handler = std::forward<decltype(handler)>(handler)]() mutable {
                pending_map_[id] = entry;
                setup_timeout(id, timeout);
                // ... resto da lógica
            });
        }, token);
}
```

### 2. Eliminar mutex usando strand:

```cpp
auto acquire_pending_entry() -> std::shared_ptr<PendingEntry> {
    // Must be called from strand
    if (!pending_entry_pool_.empty()) {
        auto e = pending_entry_pool_.back();
        pending_entry_pool_.pop_back();
        e->reset(); // helper method
        return e;
    }
    return std::make_shared<PendingEntry>();
}
```

