## SUGESTOES DE CORRECAO

```cpp
#include "wait_helpers.hpp"
#include <gtest/gtest.h>
#include <string_view>

namespace wait = webdriver::wait;

class WaitHelpersTest : public ::testing::Test {
protected:
    static bool script_contains(std::string_view script, std::string_view substr) {
        return script.find(substr) != std::string_view::npos;
    }
};

TEST_F(WaitHelpersTest, ScriptContainsFunctionName) {
    const auto& script = wait::wait_for_element_script;
    
    // Verify core components are present
    EXPECT_TRUE(script_contains(script, "waitForElement"));
    EXPECT_TRUE(script_contains(script, "MutationObserver"));
    EXPECT_TRUE(script_contains(script, "setTimeout"));
}

TEST_F(WaitHelpersTest, ScriptHasArgumentsPlaceholders) {
    const auto& script = wait::wait_for_element_script;
    
    // Verify expected argument positions
    EXPECT_TRUE(script_contains(script, "arguments[0]"));
    EXPECT_TRUE(script_contains(script, "arguments[1]"));
    EXPECT_TRUE(script_contains(script, "arguments[2]"));
}

TEST_F(WaitHelpersTest, ScriptStructureValidation) {
    const auto& script = wait::wait_for_element_script;
    
    // More comprehensive structural checks
    EXPECT_TRUE(script_contains(script, "return new Promise"));
    EXPECT_TRUE(script_contains(script, "document.querySelector"));
    EXPECT_TRUE(script_contains(script, "observer.disconnect"));
}
```

