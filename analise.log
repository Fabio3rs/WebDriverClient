TEST(PendingEntryPoolVecTest, AcquireNonBlockingAndFallback) {
    constexpr size_t pool_capacity = 1;
    bidi::core::PendingEntryPoolVec pool(pool_capacity);

    // First acquire should get a pooled slot
    auto first_handle = pool.acquire_nonblocking();
    ASSERT_TRUE(static_cast<bool>(first_handle));
    
    // Verify first handle is from pool (not fallback)
    EXPECT_FALSE(first_handle.is_fallback()); // Assume this method exists
    
    // Second acquire should fallback to heap (pool at capacity)
    auto second_handle = pool.acquire_nonblocking();
    ASSERT_TRUE(static_cast<bool>(second_handle));
    
    // Second handle should be fallback since pool is full
    EXPECT_TRUE(second_handle.is_fallback()); // More explicit test
    
    auto fallback_ptr = second_handle.release_fallback();
    if (fallback_ptr) {
        // Test meaningful fields based on PendingEntry specification
        EXPECT_NE(fallback_ptr.get(), nullptr);
        // Add more specific validations based on PendingEntry interface
    }
    
    // Test that releasing first handle returns slot to pool
    first_handle.reset(); // or appropriate release method
    
    // Third acquire should now get pooled slot again
    auto third_handle = pool.acquire_nonblocking();
    EXPECT_FALSE(third_handle.is_fallback());
}

// Add comprehensive tests
TEST(PendingEntryPoolVecTest, PoolCapacityRespected) {
    constexpr size_t capacity = 3;
    bidi::core::PendingEntryPoolVec pool(capacity);
    
    std::vector<decltype(pool.acquire_nonblocking())> handles;
    
    // Fill pool to capacity
    for (size_t i = 0; i < capacity; ++i) {
        auto handle = pool.acquire_nonblocking();
        ASSERT_TRUE(static_cast<bool>(handle));
        handles.push_back(std::move(handle));
    }
    
    // Next acquire should be fallback
    auto fallback_handle = pool.acquire_nonblocking();
    EXPECT_TRUE(fallback_handle.is_fallback());
}

TEST(PendingEntryPoolVecTest, ReleaseAndReuse) {
    bidi::core::PendingEntryPoolVec pool(1);
    
    {
        auto handle = pool.acquire_nonblocking();
        EXPECT_FALSE(handle.is_fallback());
    } // handle destroyed, slot should return to pool
    
    // Should reuse the same slot
    auto reused_handle = pool.acquire_nonblocking();
    EXPECT_FALSE(reused_handle.is_fallback());
}
```

