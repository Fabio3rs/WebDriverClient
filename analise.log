```cpp
// Correção para async_send - usar sistema de erros bidi correto
template <class CompletionToken>
auto Client::async_send(std::string_view method, boost::json::object params,
                        CompletionToken &&token) {
    using handler_sig = void(boost::system::error_code, boost::json::object);
    return boost::asio::async_initiate<CompletionToken, handler_sig>(
        [self = shared_from_this(), method, params = std::move(params)]
        (auto handler) mutable {
            self->session_->send_command(
                std::string(method), params,
                [handler = std::move(handler)](
                    const core::ParsedResponse &response) mutable {
                    if (!response.is_success) {
                        // Usar sistema bidi de erros
                        boost::system::error_code ec = 
                            bidi::make_error_code(bidi::errc::server_error);
                        handler(ec, {});
                    } else {
                        handler({}, response.result);
                    }
                });
        }, token);
}

// Correção para get_executor - garantir strand
boost::asio::any_io_executor Client::get_executor() const {
    return session_->get_strand().get_inner_executor(); 
}

// Correção para set_event_handler - usar strand correto
boost::asio::awaitable<void>
set_event_handler(std::string method,
                  std::function<void(boost::json::object)> handler) {
    co_await boost::asio::dispatch(
        boost::asio::bind_executor(session_->get_strand(),
                                   boost::asio::use_awaitable));
    session_->set_event_handler(std::move(method), std::move(handler));
}
```

