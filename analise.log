using namespace bidi::core;

TEST(BidiMessage, IsIdSafeValidatesJavaScriptSafeIntegers) {
    // JavaScript safe integer range: -(2^53-1) to 2^53-1
    EXPECT_TRUE(is_id_safe(0));
    EXPECT_TRUE(is_id_safe(1));
    EXPECT_TRUE(is_id_safe(9007199254740991ULL)); // 2^53-1 (MAX_SAFE_INTEGER)
    EXPECT_FALSE(is_id_safe(9007199254740992ULL)); // 2^53 (beyond safe range)
}

TEST(BidiMessage, BuildCommandAndDetectMessageKind) {
