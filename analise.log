#include <bidi/core.hpp>
#include <bidi/commands.hpp>
#include <bidi/ids.hpp>
#include <gtest/gtest.h>
#include <boost/asio.hpp>

class BidiTests : public ::testing::Test {
protected:
    void SetUp() override {
        // Configurar io_context + strand para testes
        ctx_ = std::make_unique<boost::asio::io_context>();
        strand_ = std::make_unique<boost::asio::strand<boost::asio::io_context::executor_type>>(
            ctx_->get_executor());
        
        client_ = std::make_unique<bidi::BidiClient>(*strand_);
    }

    void TearDown() override {
        // Cleanup assíncrono cooperativo
        if (client_) {
            client_->close();
        }
    }

private:
    std::unique_ptr<boost::asio::io_context> ctx_;
    std::unique_ptr<boost::asio::strand<boost::asio::io_context::executor_type>> strand_;
    std::unique_ptr<bidi::BidiClient> client_;
};

TEST_F(BidiTests, LazyNavigationWithTerminal) {
    using namespace std::chrono_literals;
    
    auto operation = client_->send(
        bidi::ids::methods::bc_create, 
        boost::json::object{{"type", "window"}}
    ).and_then([](auto ctx_result) {
        return client_->send(
            bidi::ids::methods::bc_navigate,
            boost::json::object{
                {"context", ctx_result.at("context").as_string()},
                {"url", "http://localhost:8080"},
                {"wait", "complete"}
            }
        );
    }).timeout(5s)
    .on_error([](std::error_code ec) -> std::expected<boost::json::object, std::error_code> {
        return std::unexpected(ec);
    });

    // Terminal que materializa a operação
    std::expected<boost::json::object, std::error_code> result;
    operation.finally([&result](auto res, auto ec, auto duration) {
        if (ec) {
            result = std::unexpected(ec);
        } else {
            result = res;
        }
    });

    // Run event loop até completar
    ctx_->run();
    
    EXPECT_TRUE(result.has_value());
}
```

