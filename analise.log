```cpp
namespace bidi {
    class AsyncCurlClient {
        boost::asio::thread_pool& pool_;
        boost::asio::strand<boost::asio::any_io_executor> strand_;
        
    public:
        template<typename CompletionToken>
        auto async_post_json(const std::string& url, 
                           const std::string& json,
                           CompletionToken&& token) {
            return boost::asio::async_initiate<CompletionToken, 
                void(std::error_code, std::string)>(
                [self = this, url, json](auto&& handler) mutable {
                    boost::asio::post(self->pool_, [=, h = std::forward<decltype(handler)>(handler)]() mutable {
                        auto result = self->perform_curl_post(url, json);
                        boost::asio::post(self->strand_, [=, h = std::move(h)]() mutable {
                            if (result.curl_perfm_res == CURLE_OK) {
                                h(std::error_code{}, std::move(result.body));
                            } else {
                                h(make_error_code(bidi::errc::transport), "");
                            }
                        });
                    });
                }, token);
        }
    };
}
```

**2. Error Handling Robusto:**
```cpp
auto CurlRAII::perform_curl_post(const std::string& url, const std::string& json) -> CurlResult {
    CurlResult result;
    curlraii_t curl = make_curl_easy();
    
    if (!curl) {
        result.error = "Failed to initialize CURL";
        return result;
    }
    
    // Configurar timeout
    curl_easy_setopt(curl.get(), CURLOPT_TIMEOUT_MS, 30000L);
    curl_easy_setopt(curl.get(), CURLOPT_CONNECTTIMEOUT_MS, 10000L);
    
    // ... resto da configuração
    
    result.curl_perfm_res = curl_easy_perform(curl.get());
    
    // Mapear erros CURL para bidi::errc
    switch (result.curl_perfm_res) {
        case CURLE_OK:
            curl_easy_getinfo(curl.get(), CURLINFO_RESPONSE_CODE, &result.response_code);
            break;
        case CURLE_OPERATION_TIMEDOUT:
            result.error_code = bidi::errc::timeout;
            break;
        case CURLE_COULDNT_CONNECT:
            result.error_code = bidi::errc::transport;
            break;
        default:
            result.error_code = bidi::errc::transport;
            break;
    }
    
    return result;
}
```

**3. RAII Thread-Safe:**
```cpp
class CurlGlobalManager {
    std::atomic<int> ref_count_{0};
    std::mutex mutex_;
    
public:
    void acquire() {
        std::lock_guard<std::mutex> lock(mutex_);
        if (ref_count_.fetch_add(1) == 0) {
            curl_global_init(CURL_GLOBAL_DEFAULT);
        }
    }
    
    void release() {
        std::lock_guard<std::mutex> lock(mutex_);
        if (ref_count_.fetch_sub(1) == 1) {
            curl_global_cleanup();
        }
    }
};
```

