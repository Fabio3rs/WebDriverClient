    EXPECT_EQ(counter.value(), single_increment);
    counter.inc(batch_increment);
    EXPECT_EQ(counter.value(), single_increment + batch_increment);
}

TEST(Metrics, HistogramObserve) {
    Registry reg;
    const auto& hist = reg.histogram("test.hist");
    EXPECT_EQ(hist.count(), 0U);
    
    constexpr double first_sample = 1.0;
    constexpr double second_sample = 2.0;
    constexpr int sample_us = 10;
    
    hist.observe(first_sample);
    hist.observe(second_sample);
    hist.observe(sample_us);
    
    constexpr std::uint64_t expected_count = 3U;
    EXPECT_EQ(hist.count(), expected_count);
    
    const auto snap = hist.snapshot();
    // Verify at least one bucket contains observations
    const bool has_observations = std::any_of(snap.begin(), snap.end(),
        [](const auto& value) { return value > 0; });
    EXPECT_TRUE(has_observations);
}
