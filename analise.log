```cpp
// ThreadPoolWrapper.hpp — Injectable RAII wrapper around boost::asio::thread_pool
// Provides safe access to thread pool with configurable ownership semantics
#pragma once

#include <boost/asio/thread_pool.hpp>
#include <memory>
#include <thread>

namespace webdriver {

/**
 * RAII wrapper for boost::asio::thread_pool with injectable ownership.
 * Supports both owned and external (shared) thread pools.
 * Thread-safe for concurrent access to get() method.
 */
class ThreadPool {
private:
    static constexpr std::size_t MIN_THREADS = 1;
    std::shared_ptr<boost::asio::thread_pool> pool_ptr_;

public:
    /// Creates owned thread pool with hardware_concurrency threads (min 1)
    [[nodiscard]] ThreadPool()
        : pool_ptr_(std::make_shared<boost::asio::thread_pool>(
              std::max<std::size_t>(MIN_THREADS, std::thread::hardware_concurrency()))) {}

    /// Injects external thread pool (shared ownership)
    [[nodiscard]] explicit ThreadPool(std::shared_ptr<boost::asio::thread_pool> external)
        : pool_ptr_(std::move(external)) {}

    /// Non-copyable (expensive resource)
    ThreadPool(const ThreadPool&) = delete;
    ThreadPool& operator=(const ThreadPool&) = delete;

    /// Movable
    ThreadPool(ThreadPool&&) = default;
    ThreadPool& operator=(ThreadPool&&) = default;

    /// Access underlying thread pool (non-const)
    [[nodiscard]] boost::asio::thread_pool& get() {
        if (!pool_ptr_) {
            throw std::runtime_error("ThreadPool: null pool access");
        }
        return *pool_ptr_;
    }

    /// Access underlying thread pool (const)
    [[nodiscard]] const boost::asio::thread_pool& get() const {
        if (!pool_ptr_) {
            throw std::runtime_error("ThreadPool: null pool access");
        }
        return *pool_ptr_;
    }

    /// Check if pool is valid
    [[nodiscard]] bool valid() const noexcept { return static_cast<bool>(pool_ptr_); }

    /// Get thread count
    [[nodiscard]] std::size_t size() const {
        return valid() ? pool_ptr_->size() : 0;
    }
};

} // namespace webdriver
```

## PONTOS POSITIVOS
1. **RAII correto**: Usa `std::shared_ptr` para gerenciamento automático de recursos
2. **Injeção de dependência**: Suporta pools externos via construtor, boa para testes
3. **Thread safety básico**: `std::shared_ptr` é thread-safe para leitura concorrente
4. **Simplicidade**: Interface minimalista e focada
5. **Namespace correto**: Segue convenção do projeto
6. **Move semantics**: Construtor com `std::move` para eficiência
7. **Hardware detection**: Usa `hardware_concurrency()` sensatamente

