```cpp
#include "asyncx.hpp"
#include <atomic>
#include <boost/asio/thread_pool.hpp>
#include <future>
#include <gtest/gtest.h>
#include <thread>

using namespace std::chrono_literals;

TEST(PoolInjection, FromFutureRunsOnInjectedPoolThread) {
    auto pool = std::make_shared<boost::asio::thread_pool>(2); // Mais threads

    std::atomic<std::thread::id> pool_thread_id{std::thread::id{}}; // Init explícita
    std::promise<void> ready;
    auto ready_f = ready.get_future();

    // Post a task to capture one of the pool thread ids and signal ready.
    boost::asio::post(*pool, [&pool_thread_id, &ready] {
        pool_thread_id.store(std::this_thread::get_id());
        ready.set_value();
    });

    // Wait for pool thread to capture its id
    ASSERT_EQ(ready_f.wait_for(1s), std::future_status::ready);

    // Use a blocking future that does real work
    std::atomic<std::thread::id> future_execution_thread_id{std::thread::id{}};
    auto blocking_future = std::async(std::launch::async, [&future_execution_thread_id]() {
        future_execution_thread_id.store(std::this_thread::get_id());
        std::this_thread::sleep_for(10ms); // Simulate work
        return 12345;
    });

    // Use Async::from_future with pool injection
    auto async_result = asyncx::Async<int>::from_future(
        boost::asio::system_executor{}, 
        std::move(blocking_future), 
        pool
    );

    std::promise<int> completion_promise;
    auto completion_future = completion_promise.get_future();

    async_result.finally([&completion_promise](
        std::optional<int> value,
        [[maybe_unused]] std::optional<asyncx::EC> error_code,
        const std::exception_ptr& exception_ptr) {
        
        if (value.has_value()) {
            completion_promise.set_value(*value);
        } else {
            completion_promise.set_exception(
                exception_ptr ? exception_ptr 
                              : std::make_exception_ptr(std::runtime_error("no value"))
            );
        }
    });

    // Wait for completion with timeout
    ASSERT_EQ(completion_future.wait_for(2s), std::future_status::ready);
    auto result = completion_future.get();
    
    EXPECT_EQ(result, 12345);
    
    // Verify thread IDs are set (but they may be different threads)
    ASSERT_NE(pool_thread_id.load(), std::thread::id{});
    ASSERT_NE(future_execution_thread_id.load(), std::thread::id{});

    pool->join();
}
```

### **PONTOS POSITIVOS**

1. **Teste conceitual correto**: Verifica injeção de thread pool no `from_future`
2. **Uso apropriado de atomics**: Para sincronização thread-safe de IDs
3. **RAII com pool**: Gerenciamento correto do ciclo de vida
4. **Verificação de resultados**: Valida tanto valor quanto execução em thread correto
5. **Cleanup adequado**: `pool->join()` no final

