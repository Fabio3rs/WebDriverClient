```cpp
class Arena {
public:
    explicit Arena(std::size_t size = MEDIUM_ARENA_SIZE) 
        : resource_(size) {}
    
    // Explicit destructor for proper cleanup order
    ~Arena() noexcept {
        // Logging/metrics if needed
    }
    
    // Make movable for unique_ptr efficiency
    Arena(Arena&& other) noexcept = default;
    Arena& operator=(Arena&& other) noexcept = default;
    
    // Non-copyable
    Arena(const Arena&) = delete;
    Arena& operator=(const Arena&) = delete;
    
    // Const-correct resource access
    [[nodiscard]] boost::json::memory_resource* resource() noexcept {
        return &resource_;
    }
    [[nodiscard]] const boost::json::memory_resource* resource() const noexcept {
        return &resource_;
    }
    
    // Error-safe parsing
    [[nodiscard]] std::expected<boost::json::value, std::error_code> 
    parse(std::string_view json_text) {
        try {
            return boost::json::parse(json_text, resource());
        } catch (...) {
            return std::make_error_code(bidi::errc::decode_error);
        }
    }
};

// Better size estimation with overhead
std::size_t calculate_arena_size(std::size_t estimated_json_size) {
    // JSON parsing typically needs 2.5-3x overhead
    std::size_t needed = estimated_json_size * 3;
    
    if (needed <= SMALL_ARENA_SIZE) return SMALL_ARENA_SIZE;
    if (needed <= MEDIUM_ARENA_SIZE) return MEDIUM_ARENA_SIZE;
    return LARGE_ARENA_SIZE;
}
```

