**3. Helper para tratamento de erro:**
```cpp
template<typename T>
bool handle_result(const std::optional<T>& result, 
                  const std::optional<std::error_code>& ec,
                  const std::exception_ptr& ep,
                  const std::string& operation) {
    if (ep) {
        try { std::rethrow_exception(ep); }
        catch (const std::exception& e) {
            bidi::logging::log_error(fmt::format("{} failed with exception: {}", 
                                                operation, e.what()));
        }
        return false;
    }
    if (ec && *ec) {
        bidi::logging::log_error(fmt::format("{} failed with error: {}", 
                                            operation, ec->message()));
        return false;
    }
    if (!result) {
        bidi::logging::log_error(fmt::format("{} returned no result", operation));
        return false;
    }
    return true;
}
```

