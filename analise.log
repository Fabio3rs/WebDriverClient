    EXPECT_TRUE(parsed.has_value());
    EXPECT_EQ(parsed->method, bidi::ids::events::log_entryAdded);
    EXPECT_TRUE(parsed->params.if_contains("level"));
    EXPECT_TRUE(parsed->params.if_contains("text"));
}

