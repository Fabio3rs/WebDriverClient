#include "bidi/core.hpp"
#include <gtest/gtest.h>

// Uso mais específico do namespace
using bidi::core::detect_message_kind;
using bidi::core::parse_response; 
using bidi::core::parse_event;
using bidi::core::MessageKind;

TEST(BidiParsingNegative, DetectMessageKindVariants) {
    // Response success
    EXPECT_EQ(detect_message_kind(R"({"id":1,"type":"success"})"),
              MessageKind::Response);
    // Response error  
    EXPECT_EQ(detect_message_kind(R"({"id":2,"type":"error"})"),
              MessageKind::Response);
    // Event
    EXPECT_EQ(detect_message_kind(R"({"type":"event","method":"log.entryAdded"})"),
              MessageKind::Event);
    // Command
    EXPECT_EQ(detect_message_kind(R"({"id":3,"method":"browsingContext.create"})"),
              MessageKind::Command);
    // Unknown - method without id (invalid command)
    EXPECT_EQ(detect_message_kind(R"({"method":"test"})"), MessageKind::Unknown);
    // Unknown - empty object
    EXPECT_EQ(detect_message_kind("{}"), MessageKind::Unknown);
    
    // Adicionar testes com JSON inválido
    EXPECT_EQ(detect_message_kind("invalid json"), MessageKind::Unknown);
    EXPECT_EQ(detect_message_kind("null"), MessageKind::Unknown);
    EXPECT_EQ(detect_message_kind("[]"), MessageKind::Unknown);
}

TEST(BidiParsingNegative, ParseResponseInvalidCases) {
    // Missing id - violates BiDi spec requirement
    EXPECT_FALSE(parse_response(R"({"type":"success","result":{}})"));
    
    // Missing type - cannot determine success/error
    EXPECT_FALSE(parse_response(R"({"id":1,"result":{}})"));
    
    // Unknown type - not "success" or "error" 
    EXPECT_FALSE(parse_response(R"({"id":1,"type":"unknown"})"));
    
    // Error response with missing error fields (spec allows optional fields)
    auto err = parse_response(R"({"id":2,"type":"error"})");
    ASSERT_TRUE(err.has_value());
    EXPECT_FALSE(err->is_success);
    EXPECT_TRUE(err->error_code.empty());
    EXPECT_TRUE(err->error_message.empty());
    
    // Success response with missing result (spec allows empty result)
    auto ok = parse_response(R"({"id":3,"type":"success"})");
    ASSERT_TRUE(ok.has_value()); 
    EXPECT_TRUE(ok->is_success);
    EXPECT_TRUE(ok->result.empty());
}

TEST(BidiParsingNegative, ParseEventInvalidCases) {
    // Missing type field - cannot identify as event
    EXPECT_FALSE(parse_event(R"({"method":"log.entryAdded"})"));
    
    // Wrong type value - not "event"
    EXPECT_FALSE(parse_event(R"({"type":"success","method":"log.entryAdded"})"));
    
    // Missing method - event must have method name
    EXPECT_FALSE(parse_event(R"({"type":"event"})"));
    
    // Invalid JSON syntax
    EXPECT_FALSE(parse_event("invalid json"));
}
```

