```cpp
// include/bidi/message_queue.hpp - Aligned with bidi-x architecture
#pragma once

#include "bidi/core.hpp"
#include "bidi/buffer_pool.hpp"
#include <boost/container/small_vector.hpp>
#include <deque>
#include <memory>

namespace bidi::core {

/**
 * @brief Strand-based message queue for WebSocket writes
 * 
 * Integrates with bidi-x pools and strand architecture.
 * No lock-free complexity - strand provides ordering guarantees.
 */
class StrandMessageQueue {
public:
    // Use dynamic allocation for BiDi's variable message sizes
    struct QueuedMessage {
        std::unique_ptr<char[]> data;
        std::size_t length;
        core::id_type message_id;
        
        QueuedMessage(std::string_view msg, core::id_type id)
            : data{std::make_unique<char[]>(msg.size() + 1)}
            , length{msg.size()}
            , message_id{id} {
            std::copy(msg.begin(), msg.end(), data.get());
            data[length] = '\0';
        }
        
        [[nodiscard]] std::string_view as_string_view() const noexcept {
            return {data.get(), length};
        }
    };

private:
    std::deque<QueuedMessage> queue_; // Simple, strand-protected
    std::size_t total_bytes_{0};
    static constexpr std::size_t MAX_TOTAL_BYTES = 1024 * 1024; // 1MB limit

public:
    // Thread-safe via strand (not lock-free)
    [[nodiscard]] bool try_enqueue(std::string_view message, id_type id = 0) {
        if (total_bytes_ + message.size() > MAX_TOTAL_BYTES) {
            return false; // Backpressure
        }
        
        queue_.emplace_back(message, id);
        total_bytes_ += message.size();
        return true;
    }
    
    [[nodiscard]] bool try_dequeue(QueuedMessage& msg) {
        if (queue_.empty()) return false;
        
        msg = std::move(queue_.front());
        total_bytes_ -= msg.length;
        queue_.pop_front();
        return true;
    }
    
    [[nodiscard]] std::size_t size() const noexcept { 
        return queue_.size(); 
    }
    
    [[nodiscard]] std::size_t total_bytes() const noexcept {
        return total_bytes_;
    }
    
    [[nodiscard]] bool empty() const noexcept { 
        return queue_.empty(); 
    }
    
    void clear() {
        queue_.clear();
        total_bytes_ = 0;
    }
};

/**
 * @brief Optimized pending map using unordered_map for O(1) access
 * ID lookup is more critical than iteration for BiDi pending requests
 */
template<typename T>
class OptimizedPendingMap {
    std::unordered_map<core::id_type, T> pending_;
    
public:
    explicit OptimizedPendingMap(std::size_t expected_capacity = 64) {
        pending_.reserve(expected_capacity);
    }
    
    template<typename... Args>
    void emplace(core::id_type id, Args&&... args) {
        pending_.emplace(id, std::forward<Args>(args)...);
    }
    
    [[nodiscard]] auto find(core::id_type id) {
        return pending_.find(id);
    }
    
    [[nodiscard]] bool erase(core::id_type id) {
        return pending_.erase(id) > 0;
    }
    
    // Standard interface...
    [[nodiscard]] std::size_t size() const noexcept { return pending_.size(); }
    [[nodiscard]] bool empty() const noexcept { return pending_.empty(); }
    void clear() noexcept { pending_.clear(); }
};

} // namespace bidi::core
```

## PONTOS POSITIVOS

1. **Uso correto de [[nodiscard]]** - previne ignorar erros
2. **RAII com non-copyable/non-movable** - evita acidentes de lifetime
3. **Template design para OptimizedPendingMap** - reutilizável
4. **Namespace organizado** - segue estrutura do projeto
5. **Const correctness** - métodos const onde apropriado
6. **Early returns** - estrutura de controle clara

## SCORE FINAL: 3/10

**Justificativa:**
- **Conformidade arquitetura (40%)**: 2/10 - Lock-free contradiz strand model
- **Core Guidelines (30%)**: 6/10 - Boa estrutura RAII, mas fixed buffer unsafe
- **Performance (20%)**: 4/10 - Claims não validadas, design questionável para BiDi
- **Qualidade (10%)**: 5/10 - Documentação presente mas inconsistente

**Principais problemas**: Truncamento silencioso quebra protocolo BiDi; lock-free desnecessário vs strand; sem integração com pools existentes; backpressure inadequado.

**Recomendação**: Reescrever usando strand + deque + dynamic allocation + integração com buffer_pool existente.

