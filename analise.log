#pragma once

#include <system_error>
#include <expected>

#ifdef _WIN32
#include <winsock2.h>
#include <ws2tcpip.h>
#pragma comment(lib, "ws2_32.lib")
#else
#include <sys/socket.h>
#include <netinet/in.h>
#include <unistd.h>
#endif

namespace bidi::utils {

namespace detail {
    constexpr int DEFAULT_LISTEN_BACKLOG = 5;
    
    class SocketRAII {
    public:
#ifdef _WIN32
        using socket_type = SOCKET;
        static constexpr socket_type INVALID = INVALID_SOCKET;
        
        explicit SocketRAII(socket_type sock) : sock_(sock) {}
        ~SocketRAII() { 
            if (sock_ != INVALID) {
                closesocket(sock_);
            }
        }
#else
        using socket_type = int;
        static constexpr socket_type INVALID = -1;
        
        explicit SocketRAII(socket_type sock) : sock_(sock) {}
        ~SocketRAII() { 
            if (sock_ != INVALID) {
                close(sock_);
            }
        }
#endif
        
        SocketRAII(const SocketRAII&) = delete;
        SocketRAII& operator=(const SocketRAII&) = delete;
        SocketRAII(SocketRAII&& other) noexcept : sock_(other.sock_) {
            other.sock_ = INVALID;
        }
        SocketRAII& operator=(SocketRAII&& other) noexcept {
            if (this != &other) {
                if (sock_ != INVALID) {
#ifdef _WIN32
                    closesocket(sock_);
#else
                    close(sock_);
#endif
                }
                sock_ = other.sock_;
                other.sock_ = INVALID;
            }
            return *this;
        }
        
        [[nodiscard]] socket_type get() const noexcept { return sock_; }
        [[nodiscard]] bool valid() const noexcept { return sock_ != INVALID; }
        
    private:
        socket_type sock_;
    };

#ifdef _WIN32
    class WSAInitializer {
    public:
        WSAInitializer() {
            WSADATA wsaData;
            if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0) {
                throw std::system_error(WSAGetLastError(), std::system_category(), 
                                      "WSAStartup failed");
            }
        }
        ~WSAInitializer() { WSACleanup(); }
        WSAInitializer(const WSAInitializer&) = delete;
        WSAInitializer& operator=(const WSAInitializer&) = delete;
    };
#endif
}

/**
 * @brief Finds an available port by binding to port 0 and querying the assigned port.
 * 
 * This function creates a temporary socket, binds it to localhost:0 (which causes
 * the OS to assign a free port), queries the assigned port number, and then
 * closes the socket.
 * 
 * @warning There's a race condition: the port might be taken by another process
 *          between when this function returns and when the caller uses it.
 * 
 * @return Expected containing the port number on success, or error_code on failure
 */
[[nodiscard]] inline std::expected<int, std::error_code> 
find_free_port() noexcept {
    try {
#ifdef _WIN32
        detail::WSAInitializer wsa; // RAII WSA cleanup
        
        detail::SocketRAII sock(socket(AF_INET, SOCK_STREAM, 0));
        if (!sock.valid()) {
            return std::unexpected(std::error_code(WSAGetLastError(), 
                                                 std::system_category()));
        }
#else
        detail::SocketRAII sock(socket(AF_INET, SOCK_STREAM, 0));
        if (!sock.valid()) {
            return std::unexpected(std::error_code(errno, std::system_category()));
        }
#endif

        sockaddr_in addr{};  // zero-initialization
        addr.sin_family = AF_INET;
        addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
        addr.sin_port = htons(0);  // Let OS assign port

        if (bind(sock.get(), reinterpret_cast<const sockaddr*>(&addr), 
                sizeof(addr)) != 0) {
#ifdef _WIN32
            return std::unexpected(std::error_code(WSAGetLastError(), 
                                                 std::system_category()));
#else
            return std::unexpected(std::error_code(errno, std::system_category()));
#endif
        }

        if (listen(sock.get(), detail::DEFAULT_LISTEN_BACKLOG) != 0) {
#ifdef _WIN32
            return std::unexpected(std::error_code(WSAGetLastError(), 
                                                 std::system_category()));
#else
            return std::unexpected(std::error_code(errno, std::system_category()));
#endif
        }

        socklen_t addr_len = sizeof(addr);
        if (getsockname(sock.get(), reinterpret_cast<sockaddr*>(&addr), 
                       &addr_len) != 0) {
#ifdef _WIN32
            return std::unexpected(std::error_code(WSAGetLastError(), 
                                                 std::system_category()));
#else
            return std::unexpected(std::error_code(errno, std::system_category()));
#endif
        }

        return static_cast<int>(ntohs(addr.sin_port));
        
    } catch (const std::exception&) {
        return std::unexpected(std::make_error_code(std::errc::operation_not_supported));
    }
}

// Compatibility wrapper for legacy code
[[deprecated("Use find_free_port() that returns std::expected instead")]]
[[nodiscard]] inline int free_port() noexcept {
    auto result = find_free_port();
    return result ? *result : -1;
}

} // namespace bidi::utils
```

