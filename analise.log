// Substituir exceções por std::expected
static std::expected<curlslitraii_t, std::error_code> 
curl_slist_append_raii(curlslitraii_t& ptr, const char* str) noexcept {
    curl_slist* tmp = curl_slist_append(ptr.get(), str);
    if (tmp == nullptr) {
        return std::unexpected(std::make_error_code(std::errc::no_buffer_space));
    }
    
    if (!ptr) {
        ptr = curlslitraii_t(tmp);
    }
    
    if (ptr.get() != tmp) {
        return std::unexpected(std::make_error_code(std::errc::invalid_argument));
    }
    
    return std::move(ptr);
}

// Versão assíncrona compatível com bidi-x
template<typename CompletionToken>
auto async_post_json(boost::asio::io_context& ioc, 
                    const std::string& url, 
                    const std::string& json,
                    CompletionToken&& token) {
    return boost::asio::async_initiate<CompletionToken, 
        void(std::error_code, curlCallBack)>(
        [&ioc, url, json](auto&& handler) {
            boost::asio::post(ioc, [handler = std::move(handler), url, json]() mutable {
                auto result = postJson(url, json);
                handler(std::error_code{}, std::move(result));
            });
        }, token);
}

// Singleton thread-safe
static CurlRAII& instance() {
    static std::once_flag flag;
    static std::unique_ptr<CurlRAII> instance_ptr;
    
    std::call_once(flag, []() {
        instance_ptr = std::make_unique<CurlRAII>();
    });
    
    return *instance_ptr;
}
```

