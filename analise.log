    EXPECT_TRUE(parsed.has_value());
    ASSERT_TRUE(parsed->is_success);
    EXPECT_EQ(parsed->id, 42);
    ASSERT_TRUE(parsed->result.if_contains("sessionId"));
    EXPECT_EQ(parsed->result["sessionId"].as_string(), "test-session");
}

