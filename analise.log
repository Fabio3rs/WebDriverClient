namespace bidi::pools {

using bidi::core::id_type;
using bidi::core::error_code;

// Handler deve ser compatível com strand
using StrandTimeoutHandler = std::function<void(id_type, error_code)>;

struct TimeoutEntry {
    id_type id{0};
    std::chrono::steady_clock::time_point expiry{};
    StrandTimeoutHandler handler{};
    bool cancelled{false};
    
    TimeoutEntry() = default;
    TimeoutEntry(id_type timeout_id, std::chrono::steady_clock::time_point exp, 
                 StrandTimeoutHandler h)
        : id{timeout_id}, expiry{exp}, handler{std::move(h)} {}
};

class StrandAwareTimerWheel {
public:
    explicit StrandAwareTimerWheel(boost::asio::strand<boost::asio::io_context::executor_type>& strand,
                                   std::chrono::milliseconds tick_interval = std::chrono::milliseconds{10});
    
