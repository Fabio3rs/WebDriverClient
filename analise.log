// src/bidi_memory_pool.cpp — Arena allocation for JSON parsing with PMR
#include "bidi/memory_pool.hpp"
#include <stdexcept>

namespace bidi::core {

JsonArenaPool::Arena::Arena(std::size_t size) 
    : resource_{size > 0 ? size : throw std::invalid_argument("Arena size must be > 0")} {}

[[nodiscard]] auto JsonArenaPool::Arena::parse(std::string_view json_text)
    -> std::expected<boost::json::value, std::error_code> {
    if (json_text.empty()) {
        return std::unexpected(make_error_code(bidi::errc::decode_error));
    }
    
    try {
        return boost::json::parse(json_text, resource());
    } catch (const std::exception&) {
        return std::unexpected(make_error_code(bidi::errc::decode_error));
    }
}

void JsonArenaPool::Arena::reset() noexcept { 
    resource_.release(); 
}

[[nodiscard]] std::size_t JsonArenaPool::Arena::bytes_used() const noexcept {
    return resource_.bytes_used();
}

[[nodiscard]] bool JsonArenaPool::Arena::is_valid() const noexcept {
    // Implementar verificação de estado se necessário
    return true;
}

} // namespace bidi::core
```

