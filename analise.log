// 1. SessionGuard::connect com tratamento robusto
auto connect(const WebDriver::json &args, const std::string &browser_name,
             bool headless) noexcept -> std::expected<std::string, std::string> {
    try {
        auto response = driver_.connect(args, browser_name, headless);
        session_id_ = driver_.sessionId;
        connected_ = true;
        
        // Validação mais robusta
        const auto* capabilities = response.find("capabilities");
        if (!capabilities || !capabilities->contains("webSocketUrl")) {
            connected_ = false;
            return std::unexpected("Missing webSocketUrl in session capabilities");
        }
        
        return capabilities->at("webSocketUrl").get<std::string>();
    } catch (const WebDriverException& ex) {
        return std::unexpected(std::format("WebDriver error: {}", ex.what()));
    } catch (const std::exception& ex) {
        return std::unexpected(std::format("Connection failed: {}", ex.what()));
    }
}

// 2. ClientGuard melhorado
void add_subscription(const std::shared_ptr<bidi::core::BiDiSession::Subscription>& subscription) {
    subscriptions_.push_back(subscription);
}

[[nodiscard]] auto subscription_count() const noexcept -> size_t {
    return subscriptions_.size();
}

// 3. IoContextGuard com work_guard
class IoContextGuard {
private:
    boost::asio::io_context& io_context_;
    boost::asio::executor_work_guard<boost::asio::io_context::executor_type> work_guard_;
    std::atomic<bool>& stop_flag_;
    std::thread runner_thread_;

public:
    IoContextGuard(boost::asio::io_context& io_context, std::atomic<bool>& flag)
        : io_context_(io_context)
        , work_guard_(boost::asio::make_work_guard(io_context))
        , stop_flag_(flag) {
        runner_thread_ = std::thread([this]() {
            try {
                io_context_.run();
                stop_flag_.store(true, std::memory_order_release);
            } catch (const std::exception& ex) {
                logging::log_error(std::format("io_context.run() failed: {}", ex.what()));
                stop_flag_.store(true, std::memory_order_release);
            }
        });
    }

    ~IoContextGuard() noexcept {
        work_guard_.reset(); // Permite io_context parar
        if (!stop_flag_.load(std::memory_order_acquire)) {
            io_context_.stop();
        }
        if (runner_thread_.joinable()) {
            runner_thread_.join();
        }
    }
};

// 4. FutureGuard com diagnóstico melhor
auto get() -> std::expected<T, std::string> {
    const auto status = future_.wait_for(timeout_);
    
    if (status == std::future_status::timeout) {
        return std::unexpected(std::format("Operation '{}' timed out after {}s", 
                                         operation_name_, timeout_.count()));
    }
    
    if (status == std::future_status::deferred) {
        return std::unexpected(std::format("Operation '{}' was deferred (not started)", 
                                         operation_name_));
    }
    
    // status == ready
    try {
        if constexpr (std::is_void_v<T>) {
            future_.get();
            return {};
        } else {
            return future_.get();
        }
    } catch (const bidi::BiDiException& ex) {
        return std::unexpected(std::format("BiDi error in '{}': {}", 
                                         operation_name_, ex.what()));
    } catch (const std::exception& ex) {
        return std::unexpected(std::format("Exception in '{}': {}", 
                                         operation_name_, ex.what()));
    }
}
```

