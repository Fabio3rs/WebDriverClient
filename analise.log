#pragma once

// Aggregated resource pool facade for BiDi implementation.
// Provides centralized access to memory pools with RAII guarantees.
// Use direct pool access in production; this facade is for testing/instrumentation.

#include "bidi/buffer_pool_vec.hpp"
#include "bidi/pending_entry_pool_vec.hpp"
#include "bidi/promise_pool.hpp"

#include <memory>

namespace bidi::core {

namespace pool_defaults {
    static constexpr std::size_t promise_pool_size = 64;
    static constexpr std::size_t pending_pool_size = 128;
    static constexpr std::size_t buffer_pool_size = 16;
}

// Lightweight facade that holds shared pool instances for tests or demos.
// Not intended for production global state; use for instrumentation only.
struct ResourcePools {
    ResourcePools()
        : promise_pool(std::make_unique<PromisePool<boost::json::object>>(
              pool_defaults::promise_pool_size)),
          pending_pool(
              std::make_unique<PendingEntryPoolVec>(pool_defaults::pending_pool_size)),
          buffer_pool(std::make_unique<BufferPoolVec>(pool_defaults::buffer_pool_size)) {}

    ~ResourcePools() = default;

    // Non-copyable, moveable
    ResourcePools(const ResourcePools&) = delete;
    ResourcePools& operator=(const ResourcePools&) = delete;
    ResourcePools(ResourcePools&&) = default;
    ResourcePools& operator=(ResourcePools&&) = default;

    // Const and non-const accessors
    [[nodiscard]] PromisePool<boost::json::object>& get_promise_pool() noexcept {
        return *promise_pool;
    }
    [[nodiscard]] const PromisePool<boost::json::object>& get_promise_pool() const noexcept {
        return *promise_pool;
    }
    
    [[nodiscard]] PendingEntryPoolVec& get_pending_pool() noexcept { 
        return *pending_pool; 
    }
    [[nodiscard]] const PendingEntryPoolVec& get_pending_pool() const noexcept { 
        return *pending_pool; 
    }
    
    [[nodiscard]] BufferPoolVec& get_buffer_pool() noexcept { 
        return *buffer_pool; 
    }
    [[nodiscard]] const BufferPoolVec& get_buffer_pool() const noexcept { 
        return *buffer_pool; 
    }

    // Aligned stats structure for optimal memory layout
    struct alignas(8) Stats {
        PromisePool<boost::json::object>::Stats promise_stats{};
        PendingEntryPoolVec::Stats pending_stats{};
        BufferPool::Stats buffer_stats{};
    };

    [[nodiscard]] Stats snapshot() const {
        return Stats{
            .promise_stats = promise_pool->get_stats(),
            .pending_stats = pending_pool->get_stats(),
            .buffer_stats = buffer_pool->get_stats()
        };
    }

private:
    std::unique_ptr<PromisePool<boost::json::object>> promise_pool;
    std::unique_ptr<PendingEntryPoolVec> pending_pool;
    std::unique_ptr<BufferPoolVec> buffer_pool;
};

// Thread-safe accessor for tests/demos - consider avoiding in production
[[nodiscard]] ResourcePools& get_default_resource_pools() {
    static ResourcePools pools;
    return pools;
}

} // namespace bidi::core
```

